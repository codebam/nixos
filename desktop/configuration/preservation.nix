_:
let
  # KConfig saves atomically by writing a temp file and renaming it over the
  # target. A file bind mount is a mount point, so that rename fails with
  # EBUSY -- KConfig then prints the misleading "Couldn't write ... Disk
  # full?". KConfig follows a symlink to its canonical path, so the rename
  # lands inside /persistent and the link survives. Directories below stay
  # bind mounts: renames within a mounted directory are ordinary operations.
  kdeFile = file: {
    inherit file;
    how = "symlink";
    createLinkTarget = true;
  };
in
{
  preservation = {
    preserveAt."/persistent" = {
      directories = [
        "/var/lib/OpenRGB"
        {
          directory = "/var/lib/transmission";
          user = "codebam";
          group = "users";
        }
        {
          directory = "/var/lib/lidarr";
          user = "codebam";
          group = "users";
        }
        {
          directory = "/var/lib/navidrome";
          user = "navidrome";
          group = "navidrome";
        }
        "/var/lib/private/prowlarr"
        {
          directory = "/var/lib/private/ollama";
          user = "ollama";
          group = "ollama";
        }
        {
          directory = "/var/lib/acme";
          user = "acme";
          group = "nginx";
        }
      ];
      users = {
        codebam = {
          files = map kdeFile [
            # KDE Plasma settings. The root wipe is what makes these matter:
            # without them a reboot returns Plasma to first-run defaults even
            # though `plasma-org.kde.plasma.desktop-appletsrc` is the entire
            # panel/widget layout. kwinoutputconfig.json, kwalletrc and
            # kwalletmanagerrc already live in the shared preservation module.
            ".config/kdeglobals"
            ".config/plasma-org.kde.plasma.desktop-appletsrc"
            ".config/plasmashellrc"
            ".config/plasma-localerc"
            ".config/kwinrc"
            ".config/kwinrulesrc"
            ".config/kglobalshortcutsrc"
            ".config/kscreenlockerrc"
            ".config/ksmserverrc"
            ".config/ksplashrc"
            ".config/krunnerrc"
            ".config/kactivitymanagerdrc"
            ".config/powerdevilrc"
            ".config/kded6rc"
            ".config/baloofilerc"
            ".config/kaccessrc"
            ".config/kcminputrc"
            ".config/kxkbrc"
            ".config/plasmanotifyrc"
            ".config/klipperrc"
          ];
          directories = [
            "Android"
            ".android"
            ".config/sunshine"
            # KDE's GTK integration writes the theme/font bridge here;
            # kde-gtk-config regenerates these files on login only when it
            # notices a change, so a wiped copy silently resets GTK apps.
            ".config/gtk-3.0"
            ".config/gtk-4.0"
            # Session env/shutdown scripts sourced by startplasma, and the
            # XDG autostart entries the Plasma session launches.
            ".config/plasma-workspace"
            ".config/autostart"
            # User-installed Plasma content: widgets, look-and-feel packages,
            # layout templates, KWin scripts/effects, decorations, colour
            # schemes and wallpapers. Stock themes come from the system
            # closure, but anything installed from the KDE Store lives here.
            ".local/share/plasma"
            ".local/share/kwin"
            ".local/share/aurorae"
            ".local/share/color-schemes"
            ".local/share/wallpapers"
            # Activity data and the KScreen display configuration.
            ".local/share/kactivitymanagerd"
            ".local/share/kscreen"
            # Konsole profiles are user data, not regenerated by the module.
            ".local/share/konsole"
            # zvec-grep state: downloaded embedding models (~640M GGUF under
            # models/), the global config, and the MCP request key. Not
            # reproducible from the flake; re-downloading on every boot is
            # wasteful.
            ".zvec-grep"
            # Per-user Hermes state installed by home/hermes.nix: API login,
            # sessions, memories, and skills. None of it is reproducible from
            # the flake, and the per-user module uses ~/.hermes rather than
            # the retired service's /var/lib/hermes.
            ".hermes"
          ];
        };
        makano = {
          commonMountOptions = [
            "x-gvfs-hide"
          ];
          directories = [
            "persist"
            # This user's own HERMES_HOME (see desktop/makano-home.nix).
            # Holds their API login, sessions, memories, and skills, none of
            # which are reproducible from the flake.
            ".hermes"
            # `wrangler login` writes its OAuth token here. Without this the
            # login is undone by the next boot.
            ".config/.wrangler"
          ];
        };
      };
    };
  };
}
